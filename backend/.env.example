# Copy to .env (locally) or add as environment variables in Hostinger hPanel
# PORT: leave UNSET on Hostinger (it assigns the port itself). Only set for local dev.
# PORT=4000
NODE_ENV=production
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_user
DB_PASSWORD=change-me
DB_NAME=u123456789_hellokakinada
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://yourdomain.com
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=https://api.yourdomain.com/media

# Frontend address (used in password-reset links). No trailing slash.
FRONTEND_URL=https://yourdomain.com

# SMTP for "Forgot password" (Hostinger email: hPanel > Emails > create mailbox)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=no-reply@yourdomain.com
SMTP_PASS=
SMTP_FROM="HelloKakinada <no-reply@yourdomain.com>"

# Google sign-in (OAuth Web client ID from console.cloud.google.com)
GOOGLE_CLIENT_ID=
