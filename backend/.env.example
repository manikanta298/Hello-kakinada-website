# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=hellokakinada

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# The very first account to ever sign up is auto-promoted to master_admin,
# mirroring the original handle_new_user() Postgres trigger.

# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Media uploads (local disk). In production point this at S3/Cloud Storage
# instead and change src/routes/media.routes.ts accordingly.
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/media

# Google Sheets import (fetchGoogleSheet passthrough) needs no secret — it
# only reads sheets shared as "Anyone with the link".
